model Project {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name           String
  domain         String @map("url")
  publicId       String @unique
  apiKeyHash     String
  apiKeyLastFour String

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  widgetConfig    WidgetConfig?
  reviewers       Reviewer[]
  feedback        Feedback[]
  gitHubLink      ProjectGitHubLink?
  linearLink      ProjectLinearLink?
  jiraLink        ProjectJiraLink?
  slackLink       ProjectSlackLink?
  feedbackColumns FeedbackColumn[]

  @@index([organizationId])
  @@index([publicId])
  @@map("project")
}

model WidgetConfig {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projectId String  @unique
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  enabled Boolean @default(true)

  @@map("widget_config")
}

model Reviewer {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  name     String
  token    String  @unique
  isActive Boolean @default(true)

  feedback Feedback[]
  comments FeedbackComment[]

  @@index([projectId])
  @@map("reviewer")
}

model Feedback {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  reviewerId String
  reviewer   Reviewer @relation(fields: [reviewerId], references: [id], onDelete: Cascade)

  status  String @default("new")
  comment String

  // Board lane (ADR-0017). Null means "first column of the status category";
  // when set, column.category always equals status.
  columnId String?
  column   FeedbackColumn? @relation(fields: [columnId], references: [id], onDelete: SetNull)
  pageUrl  String

  clickX   Float?
  clickY   Float?
  selector String?

  browserName    String?
  browserVersion String?
  os             String?
  viewportWidth  Int?
  viewportHeight Int?

  metadata Json?

  // Diagnostic Trail: console + network snapshot captured by the widget at
  // submission. Read lazily by the dashboard modal only; never selected on
  // the widget read path (kept out of the hot getFeedback query).
  diagnosticTrail Json?

  screenshotId String?
  screenshot   Asset?  @relation("FeedbackScreenshot", fields: [screenshotId], references: [id], onDelete: SetNull)

  assigneeId String?
  assignee   Member? @relation(fields: [assigneeId], references: [id], onDelete: SetNull)

  issueLink       FeedbackIssueLink?
  linearIssueLink FeedbackLinearIssueLink?
  jiraIssueLink   FeedbackJiraIssueLink?
  slackMessage    FeedbackSlackMessage?
  comments        FeedbackComment[]

  @@index([projectId])
  @@index([reviewerId])
  @@index([assigneeId])
  @@map("feedback")
}

// A per-Project kanban lane layered over Feedback.status (ADR-0017). Category is
// one of the non-archived status literals and is immutable once created.
model FeedbackColumn {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  name     String
  category String
  position Int

  feedback Feedback[]

  @@index([projectId, position])
  @@map("feedback_column")
}

// A message on a Feedback thread (ADR-0018). Written by the Feedback's Reviewer
// through the Widget, or by a Member through the dashboard. Exactly one of
// reviewerId / memberId is set, matching authorType.
model FeedbackComment {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  feedbackId String
  feedback   Feedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)

  authorType String

  reviewerId String?
  reviewer   Reviewer? @relation(fields: [reviewerId], references: [id], onDelete: SetNull)

  memberId String?
  member   Member? @relation(fields: [memberId], references: [id], onDelete: SetNull)

  body String

  @@index([feedbackId, createdAt])
  @@map("feedback_comment")
}
